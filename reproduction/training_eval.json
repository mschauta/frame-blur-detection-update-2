{
 "what": "the per-epoch evaluation of the v9 run (EMA weights, CUDA bfloat16, native frames cut to 1920 x 1072): held-out frames = a fixed hash-chosen ~10% of the six held-out films' frames, train-eval frames = a fixed ~1/600 of the training frames (each seen once in training, like every training frame), photos = the validation split of the photo pool with the evaluation recipe; the published checkpoint is epoch 19",
 "definitions": {
  "M": "mean of max(0, cell logit) over the inner cells (outer ring left out), the built-in readout",
  "bce_vs_round3": "soft binary cross-entropy (nats) of the cell logits against the round3 cell probabilities over the taught cells (outer ring and measurement-vetoed blocks left out)",
  "target_entropy": "the entropy of those soft targets over the same cells: the lowest bce_vs_round3 any model can reach; fit_above_target_entropy = bce_vs_round3 - target_entropy",
  "spearman_m_r3": "Spearman correlation of v9's M with the round3 M computed from round3's own cell map",
  "spearman_region_motion": "Spearman correlation of M with the measured region motion (px), frames with a measurement",
  "m_zero_share": "share of frames with M = 0 (no inner cell says blur)",
  "auc": "photos: AUC of M for blurred (10-30 px) against sharp (0-3 px)"
 },
